<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>My Nas</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>my_nas</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UIStatusBarHidden</key>
		<false/>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>需要访问相册以浏览和管理照片视频</string>
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>需要访问相册以保存照片</string>
		<!-- Apple Music 音乐库访问权限 -->
		<key>NSAppleMusicUsageDescription</key>
		<string>需要访问音乐库以浏览和播放本地音乐</string>
		<key>NSMicrophoneUsageDescription</key>
		<string>需要访问麦克风以支持语音搜索功能</string>
		<key>NSCameraUsageDescription</key>
		<string>需要访问相机以扫描二维码添加设备</string>
		<!-- Face ID（应用锁生物识别） -->
		<key>NSFaceIDUsageDescription</key>
		<string>使用 Face ID 解锁应用</string>
		<!-- 出口合规：App 仅使用标准系统加密 (HTTPS/TLS) -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<key>UIBackgroundModes</key>
		<array>
			<string>audio</string>
			<string>fetch</string>
			<string>processing</string>
		</array>
		<!-- Picture in Picture -->
		<key>UIRequiredDeviceCapabilities</key>
		<array>
			<string>arm64</string>
		</array>
		<key>BGTaskSchedulerPermittedIdentifiers</key>
		<array>
			<string>com.kkape.mynas.scrape</string>
		</array>
		<!-- 局域网设备发现 -->
		<key>NSLocalNetworkUsageDescription</key>
		<string>需要访问局域网以发现和连接 NAS 设备</string>
		<key>NSBonjourServices</key>
		<array>
			<string>_smb._tcp</string>
			<string>_webdav._tcp</string>
			<string>_webdavs._tcp</string>
			<string>_ftp._tcp</string>
			<string>_sftp-ssh._tcp</string>
			<string>_nfs._tcp</string>
			<string>_http._tcp</string>
			<string>_https._tcp</string>
			<string>_diskstation._tcp</string>
			<string>_synology._tcp</string>
			<string>_qnap._tcp</string>
		</array>
		<key>NSSupportsLiveActivities</key>
		<true/>
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleURLName</key>
				<string>com.kkape.mynas</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>mynas</string>
				</array>
			</dict>
		</array>
		<key>NSAppTransportSecurity</key>
		<dict>
			<key>NSAllowsArbitraryLoads</key>
			<true/>
			<key>NSAllowsLocalNetworking</key>
			<true/>
		</dict>
		<!-- Scene manifest：iOS 13+ scene-based lifecycle 必须显式声明默认 window scene，
		     否则 iOS 18+ 会让 application.windows 为空 → 全屏黑 -->
		<key>UIApplicationSceneManifest</key>
		<dict>
			<key>UIApplicationSupportsMultipleScenes</key>
			<true/>
			<key>UISceneConfigurations</key>
			<dict>
				<!-- 普通 iPhone / iPad window -->
				<key>UIWindowSceneSessionRoleApplication</key>
				<array>
					<dict>
						<key>UISceneConfigurationName</key>
						<string>Default Configuration</string>
						<key>UISceneDelegateClassName</key>
						<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					</dict>
				</array>
				<!-- CarPlay -->
				<key>CPTemplateApplicationSceneSessionRoleApplication</key>
				<array>
					<dict>
						<key>UISceneClassName</key>
						<string>CPTemplateApplicationScene</string>
						<key>UISceneConfigurationName</key>
						<string>CarPlay</string>
						<key>UISceneDelegateClassName</key>
						<string>$(PRODUCT_MODULE_NAME).CarPlaySceneDelegate</string>
					</dict>
				</array>
			</dict>
		</dict>
	</dict>
</plist>
